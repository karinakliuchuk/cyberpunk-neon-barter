<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Постав ту саму версію .NET, що й в інших проєктах команди (наприклад net10.0) -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CyberpunkNeonBarter.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Потрібен лише для Configurations/ (IEntityTypeConfiguration).
         Версію узгодь з версією EF Core в Infrastructure-проєкті Артема. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
  </ItemGroup>

</Project>
